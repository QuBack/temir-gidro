# Copy to .env and fill in. Never commit .env.
DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://localhost:8000

# Empty → local SQLite. Docker compose sets PostgreSQL itself.
# DATABASE_URL=postgres://temir:temir@localhost:5432/temir

# Published languages, comma-separated (ru,kk,ky,uz,en). Add a language only
# once its translation is complete.
SITE_LANGUAGES=ru

# Admin path — make it non-obvious in production, e.g. manage-7f3k/
ADMIN_URL=admin/

# False on staging: robots.txt "Disallow: /" + noindex on every page.
SEO_INDEXING=True
YANDEX_VERIFICATION=
GOOGLE_VERIFICATION=
YANDEX_METRIKA_ID=
# IndexNow key: any 32 hex chars, e.g. python -c "import secrets; print(secrets.token_hex(16))"
INDEXNOW_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Leads by email (each lead is in the admin anyway). Empty EMAIL_HOST — no mail.
# temir.ru mail is on Mail.ru; the password is an app password of the mailbox.
EMAIL_HOST=smtp.mail.ru
EMAIL_PORT=465
EMAIL_HOST_USER=seo@temir.ru
EMAIL_HOST_PASSWORD=
# Recipients, comma-separated
LEAD_NOTIFY_EMAILS=seo@temir.ru
