# One canonical host: www → bare domain with a permanent redirect.
www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

{$SITE_DOMAIN} {
	encode zstd gzip

	handle_path /media/* {
		root * /srv/media
		header Cache-Control "public, max-age=2592000"
		file_server
	}

	handle {
		reverse_proxy web:8000
	}
}
