# Generated by `manage.py export_static` from deploy/static/htaccess — edit the template, not the copy.
# Static export of the site for shared hosting (Apache): HTTPS, one host, the old site's
# addresses, the request form handler and long caching for hashed static files.

AddDefaultCharset utf-8
DirectoryIndex index.html
Options -Indexes
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# One host: www.{{HOST}} → {{HOST}} for good. http → https is switched on in the hosting panel
# (Timeweb terminates TLS in front of Apache, so %{HTTPS} here cannot be trusted and would loop).
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://{{HOST}}%{REQUEST_URI} [R=301,L,NE]

# The request form posts to /zayavka/: the PHP handler takes it.
RewriteCond %{REQUEST_METHOD} =POST
RewriteRule ^zayavka/?$ zayavka/send.php [L]

# Pages without the trailing slash: /o-kompanii → /o-kompanii/.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+[^/])$ /$1/ [R=301,L]

# Old site addresses (apps/core/redirects.py).
{{REDIRECTS}}
</IfModule>

<IfModule mod_mime.c>
AddType model/gltf-binary .glb
AddType image/avif .avif
AddType image/webp .webp
AddType font/woff2 .woff2
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "DENY"
# Static files have a content hash in their names: cache for a year.
<FilesMatch "\.[0-9a-f]{12}\.(css|js|webp|avif|png|jpg|svg|woff2|glb|hdr|pdf)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
<FilesMatch "\.html$">
Header set Cache-Control "no-cache"
</FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain
</IfModule>
